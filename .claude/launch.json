{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "game-studio",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "apps/game-studio"
      ],
      "port": 8005
    },
    {
      "name": "studio-bridge",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace",
        "apps/studio-bridge"
      ],
      "port": 3099
    },
    {
      "name": "web-studio-bridge",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "set -a; if [ -f apps/web/.env.studio-bridge ]; then . ./apps/web/.env.studio-bridge; fi; set +a; exec npm run dev:studio-bridge -w web -- --port 8010 --strictPort"
      ],
      "port": 8010
    }
  ]
}
